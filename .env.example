# glance-backup-status configuration
#
# This file is used by Docker Compose AND sourced by the host backup scripts.
# Keep values shell-compatible. Quote values that contain spaces.
#
# Setup:
#   cp .env.example .env
#   nano .env

# Account on the Docker host that the Flask container SSHes into.
SSH_USER=youruser

# Normally correct on Docker Engine for Linux when using the
# host-gateway mapping in docker-compose.yml.
SSH_HOST=host.docker.internal

# Absolute path to THIS repository on the Docker host.
HOST_PROJECT_DIR=/home/youruser/glance-backup-status

# Host user whose crontab/config and rclone configuration are used.
BACKUP_USER=youruser

# Store backup archives outside APPDATA/the repository to prevent recursion.
BACKUP_ROOT=/home/youruser/backups/server-config

# Docker/application-data directory to include in the backup.
# Leave empty to skip application-data backup.
APPDATA=/home/youruser/appdata

# Optional media root. Only top-level directory names under common media
# folders are inventoried; media file contents are not copied.
# Leave empty to disable the media inventory.
MEDIA_ROOT=/home/youruser/media

# Optional user-home backups. These may contain credentials/secrets.
BACKUP_USER_SSH=false
BACKUP_USER_CONFIG=false

# Optional rclone upload after the local archive is created.
RCLONE_ENABLED=false
RCLONE_REMOTE=gdrive
RCLONE_DESTINATION="Backups/server-config"

# Widget/API listener.
# 0.0.0.0 exposes the port on all host interfaces.
# For Tailscale-only access, set WIDGET_BIND to the host's Tailscale IPv4.
WIDGET_BIND=0.0.0.0
WIDGET_PORT=3030

# Widget appearance:
#   custom        = original purple theme
#   default-dark  = Glance built-in dark style
#   default-light = Glance built-in light style
#   auto          = follow browser/OS light-dark preference
WIDGET_THEME=default-dark

# Container-side SSH behavior.
SSH_STRICT_HOST_KEY_CHECKING=accept-new
SSH_KNOWN_HOSTS_FILE=/data/known_hosts
